<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Logo & Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_logo"
                android:scaleType="fitCenter"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IVAC Master Pro"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Real-time SMS &amp; OTP Sync"
                    android:textSize="12sp"
                    android:textColor="#64748B"/>
            </LinearLayout>

            <!-- Live Status Pill -->
            <LinearLayout
                android:id="@+id/layoutStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/status_bg"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:id="@+id/statusIcon"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@android:drawable/presence_offline"
                    android:layout_marginEnd="6dp"
                    app:tint="#DC2626"/>

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offline"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#DC2626"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Card 1: Desktop Connection -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="💻 Connected Desktops"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1E293B"/>

                    <TextView
                        android:id="@+id/tvDesktopCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Paired"
                        android:textSize="11sp"
                        android:textColor="#64748B"
                        android:background="#F1F5F9"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"/>
                </LinearLayout>

                <!-- Paired Desktops Chip Group -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupDesktops"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacing="6dp"
                    android:layout_marginBottom="6dp"/>

                <!-- Add Another Desktop Button (Visible when 1+ desktops exist and input box is collapsed) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddAnotherDesktop"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="+ Add Another Desktop"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0284C7"
                    app:cornerRadius="8dp"
                    app:strokeColor="#0284C7"
                    app:strokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"/>

                <!-- Input Box Layout for 6-Digit Pairing Code (Expandable / Collapsible) -->
                <LinearLayout
                    android:id="@+id/layoutPairingInputBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#F8FAFC"
                    android:padding="12dp"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enter 6-Digit Code from Desktop App:"
                        android:textSize="12sp"
                        android:textColor="#475569"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            android:hint="6-Digit Code"
                            android:layout_marginEnd="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/pairingCodeInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="6"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#0F172A" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddDesktop"
                            android:layout_width="wrap_content"
                            android:layout_height="52dp"
                            android:text="PAIR"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:backgroundTint="#0284C7"
                            android:textColor="#FFFFFF"
                            app:cornerRadius="8dp"/>
                    </LinearLayout>

                    <!-- Cancel button when adding additional desktop -->
                    <TextView
                        android:id="@+id/btnCancelAddDesktop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✕ Cancel"
                        android:textSize="12sp"
                        android:textColor="#94A3B8"
                        android:layout_gravity="end"
                        android:paddingTop="6dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 2: SIM Configuration -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="📱 SIM Numbers"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1E293B"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAutoDetectSim"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="⚡ AUTO DETECT"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:textColor="#10B981"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveSim"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="EDIT"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:textColor="#0284C7"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- SIM 1 Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutSim1Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            android:hint="SIM 1 Number"
                            app:hintTextColor="#0284C7"
                            app:boxStrokeColor="#0284C7"
                            app:expandedHintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/sim1Input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="#0F172A"
                                android:hint="019XXXXXXXX"
                                android:textColorHint="#94A3B8"
                                android:inputType="phone"
                                android:maxLength="14"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- SIM 1 Operator Badge -->
                        <TextView
                            android:id="@+id/tvSim1Operator"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="📶 Operator: Auto"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#0369A1"
                            android:background="@drawable/bg_sim_badge"
                            android:gravity="center"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- SIM 2 Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="6dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutSim2Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            android:hint="SIM 2 Number"
                            app:hintTextColor="#0284C7"
                            app:boxStrokeColor="#0284C7"
                            app:expandedHintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/sim2Input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="#0F172A"
                                android:hint="017XXXXXXXX"
                                android:textColorHint="#94A3B8"
                                android:inputType="phone"
                                android:maxLength="14"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- SIM 2 Operator Badge -->
                        <TextView
                            android:id="@+id/tvSim2Operator"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="📶 Operator: Auto"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#0369A1"
                            android:background="@drawable/bg_sim_badge"
                            android:gravity="center"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Customer Gmail / Email Input Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutGmailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:hint="Customer Gmail (যেই মেইলে OTP আসবে)"
                    app:hintTextColor="#0284C7"
                    app:boxStrokeColor="#0284C7"
                    app:expandedHintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/gmailInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#0F172A"
                        android:hint="customer@gmail.com"
                        android:textColorHint="#94A3B8"
                        android:inputType="textEmailAddress"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 3: Email OTP Forwarding Status -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="📧 Gmail &amp; Email OTP Sync"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"/>

                    <TextView
                        android:id="@+id/tvEmailSyncStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#10B981"
                        android:background="@drawable/bg_sim_badge"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="IVAC ইমেইল নোটিফিকেশন থেকে সরাসরি ওটিপি রিড করে কম্পিউটারে পাঠাবে।"
                    android:textSize="12sp"
                    android:textColor="#64748B"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnableEmailSync"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:text="Gmail নোটিফিকেশন পারমিশন দিন"
                    android:backgroundTint="#0284C7"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:visibility="gone"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 4: Quick Manual OTP Sender (Spam / Backup) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ দ্রুত ওটিপি পাঠান (ব্যাকআপ)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="10dp"
                    android:text="মেইল স্প্যামে ঢুকলে বা নোটিফিকেশন না আসলে ওটিপি এখানে লিখে সেন্ড করুন:"
                    android:textSize="12sp"
                    android:textColor="#64748B"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:hint="৬ সংখ্যার OTP"
                        app:boxStrokeColor="#0284C7">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etManualOtp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="6"
                            android:textSize="16sp"
                            android:letterSpacing="0.2"
                            android:textStyle="bold"
                            android:textColor="#0F172A"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendManualOtp"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:text="সেন্ড 🚀"
                        android:backgroundTint="#10B981"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Action Button: SMS History -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="View SMS History"
            android:backgroundTint="#0F172A"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            app:cornerRadius="10dp"
            app:icon="@android:drawable/ic_menu_recent_history"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IVAC Master Pro • Background Service Active"
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

    </LinearLayout>
</ScrollView>