<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#f4f4f9">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cloud SMS Sync"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#112240"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter the 6-digit code from the Desktop App:"
        android:textSize="16sp"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/pairingCodeInput"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="e.g. 123456"
        android:inputType="number"
        android:maxLength="6"
        android:textSize="20sp"
        android:gravity="center"
        android:background="#ffffff"
        android:elevation="2dp"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Save &amp; Connect"
        android:backgroundTint="#00d2ff"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:layout_marginBottom="30dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Permission Checklist (Required):"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnPermSms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Grant SMS Permission"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnPermBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Disable Battery Optimization"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Disconnected"
        android:textSize="16sp"
        android:textColor="#d32f2f"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:textStyle="bold"/>

</LinearLayout>