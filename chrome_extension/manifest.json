{
    "manifest_version": 3,
    "key": "",
    "name": "IVAC Master Pro",
    "version": "4.0.1",
    "description": "Automatically fills OTP from local server for IVAC website.",
    "permissions": [
        "storage",
        "unlimitedStorage",
        "activeTab",
        "scripting",
        "sidePanel",
        "bookmarks"
    ],
    "host_permissions": [
        "http://localhost:5000/*",
        "http://127.0.0.1:5000/*",
        "<all_urls>"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "IVAC Master Pro",
        "default_icon": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "inject.js"
            ],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": true
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "pdf.min.js",
                "content.js"
            ],
            "run_at": "document_idle",
            "all_frames": true
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "inject.js",
                "pdf.min.js",
                "pdf.worker.min.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    }
}